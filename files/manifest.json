{
  "manifest_version": 3,
  "name": "SENTIFY - AI Smart Chat Assistant",
  "version": "1.0",
  "description": "Hệ thống quét tin nhắn và gửi về SENTIFY Backend để phân tích an toàn.",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.messenger.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"]
}
